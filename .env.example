# ==========================================================
# CONFIGURACIÓN DE AWS BEDROCK / ENDPOINT PERSONALIZADO
# Puedes configurar esto aquí en un archivo .env O directamente
# desde el botón "Configurar AWS Bedrock" dentro de la aplicación web.
# ==========================================================

# Opción 1: Endpoint HTTP personalizado (API Gateway / Lambda / Proxy de Bedrock)
AWS_CUSTOM_ENDPOINT_URL=
AWS_CUSTOM_API_KEY=

# Opción 2: Conexión directa al SDK de AWS Bedrock Runtime
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Modelos recomendados en Bedrock con soporte de Visión + Código:
# - us.anthropic.claude-3-5-sonnet-20241022-v2:0
# - anthropic.claude-3-5-sonnet-20240620-v1:0
# - us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

PORT=3001

